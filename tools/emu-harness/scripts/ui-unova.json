// P10: the Memory Link and keys screen. Links the open White 2 save from a Black save and saves it.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/unova-sd",
  "sd_fresh": true, "elf": "../../../nds/build/verity.elf", "needles": "../needles",
  "rtc": [2026, 11, 10, 12, 0, 0],
  "steps": [{"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"assert_screen": "ui-unova-00-picker"}, {"screenshot": "00-picker.png"},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-unova-01-overview"}, {"screenshot": "01-overview.png"},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["A"], "frames": 2},
    {"wait": 120},
    {"assert_screen": "ui-unova-02-list"}, {"screenshot": "02-list.png"},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-unova-03-keys-preview"}, {"screenshot": "03-keys-preview.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 30},
    {"assert_screen": "ui-unova-04-keys-done"}, {"screenshot": "04-keys-done.png"},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-unova-05-link-preview"}, {"screenshot": "05-link-preview.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 30},
    {"assert_screen": "ui-unova-06-link-done"}, {"screenshot": "06-link-done.png"},
    {"press": ["B"], "frames": 2},
    {"wait": 30},
    {"press": ["Down"], "frames": 2}, {"wait": 5},
    {"press": ["A"], "frames": 2},
    {"wait": 240},
    {"assert_screen": "ui-unova-07-saved"}, {"screenshot": "07-saved.png"}
  ]
}
