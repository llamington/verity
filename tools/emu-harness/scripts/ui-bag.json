// The bag on the Pt save: open it, add an item and set its count, switch pouch, remove an item,
// try an event item, then save to SD.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "rtc": [2026, 11, 2, 12, 0, 0],
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2}, {"wait": 60},
    {"press": ["Down"], "frames": 2}, {"wait": 4},
    {"assert_screen": "ui-bag-00-menu"}, {"screenshot": "00-menu.png"},
    {"press": ["A"], "frames": 2}, {"wait": 30},
    {"assert_screen": "ui-bag-01-items"}, {"screenshot": "01-items.png"},
    {"press": ["R"], "frames": 2}, {"wait": 2}, {"press": ["R"], "frames": 2}, {"wait": 2},
    {"press": ["R"], "frames": 2}, {"wait": 2}, {"press": ["R"], "frames": 2}, {"wait": 2},
    {"press": ["R"], "frames": 2}, {"wait": 2}, {"press": ["R"], "frames": 2}, {"wait": 4},
    {"assert_screen": "ui-bag-02-add-row"}, {"screenshot": "02-add-row.png"},
    {"press": ["A"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-03-add-list"}, {"screenshot": "03-add-list.png"},
    {"press": ["Down"], "frames": 2}, {"wait": 4},
    {"press": ["A"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-04-count"}, {"screenshot": "04-count.png"},
    {"press": ["Up"], "frames": 2}, {"wait": 4},
    {"press": ["Right"], "frames": 2}, {"wait": 4},
    {"press": ["Right"], "frames": 2}, {"wait": 4},
    {"assert_screen": "ui-bag-05-count-13"}, {"screenshot": "05-count-13.png"},
    {"press": ["A"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-06-set"}, {"screenshot": "06-set.png"},
    {"press": ["Right"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-07-key-items"}, {"screenshot": "07-key-items.png"},
    {"press": ["Left"], "frames": 2}, {"wait": 10},
    {"press": ["Left"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-08-battle-items"}, {"screenshot": "08-battle-items.png"},
    {"press": ["X"], "frames": 2}, {"wait": 10},
    {"assert_screen": "ui-bag-09-removed"}, {"screenshot": "09-removed.png"},
    {"press": ["B"], "frames": 2}, {"wait": 40},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2}, {"wait": 4},
    {"assert_screen": "ui-bag-10-menu-save"}, {"screenshot": "10-menu-save.png"},
    {"press": ["A"], "frames": 2}, {"wait": 180},
    {"assert_screen": "ui-bag-11-saved"}, {"screenshot": "11-saved.png"}
  ]
}
