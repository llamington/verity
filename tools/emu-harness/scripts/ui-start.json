// The start screen: the logo between the top screen's panels, then after an error message
// (opening junk.sav, the 12th file in sd/) so the logo still fits beside the taller panel; it
// hides once a save opens and returns with the picker.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "rtc": [2026, 11, 2, 12, 0, 0],
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"assert_screen": "start"},
    {"screenshot": "00-start.png"},
    {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2}, {"press": ["Down"], "frames": 2}, {"wait": 2},
    {"press": ["A"], "frames": 2},
    {"wait_screen": "start-error", "timeout": 120},
    {"screenshot": "01-error.png"},
    {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2}, {"press": ["Up"], "frames": 2}, {"wait": 2},
    {"press": ["A"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "overview"}}, "timeout": 900},
    {"assert_screen": "start-opened"},
    {"screenshot": "02-opened.png"},
    {"press": ["B"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"assert_screen": "start-back"},
    {"screenshot": "03-back.png"}
  ]
}
