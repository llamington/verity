// P9.1 slice 1: picker -> overview -> box view (L/R, cursor, party), on the real Platinum save.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"assert_screen": "ui-boxes-00-picker"}, {"screenshot": "00-picker.png"},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"assert_screen": "ui-boxes-01-picker-sel"}, {"screenshot": "01-picker-sel.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-boxes-02-overview"}, {"screenshot": "02-overview.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 40},
    {"assert_screen": "ui-boxes-03-box1"}, {"screenshot": "03-box1.png"},
    {"press": ["Right"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-boxes-04-box1-cursor"}, {"screenshot": "04-box1-cursor.png"},
    {"press": ["R"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-boxes-05-box2"}, {"screenshot": "05-box2.png"},
    {"press": ["Right"], "frames": 2},
    {"wait": 3},
    {"assert_screen": "ui-boxes-05a"}, {"screenshot": "05a.png"},
    {"press": ["Right"], "frames": 2},
    {"wait": 3},
    {"assert_screen": "ui-boxes-05b"}, {"screenshot": "05b.png"},
    {"press": ["Down"], "frames": 2},
    {"wait": 3},
    {"assert_screen": "ui-boxes-05c"}, {"screenshot": "05c.png"},
    {"press": ["Down"], "frames": 2},
    {"wait": 3},
    {"assert_screen": "ui-boxes-05d"}, {"screenshot": "05d.png"},
    {"press": ["Select"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-boxes-06-party"}, {"screenshot": "06-party.png"},
    {"touch": [168, 72], "frames": 3},
    {"wait": 5},
    {"assert_screen": "ui-boxes-07-party-tap"}, {"screenshot": "07-party-tap.png"}
  ]
}
