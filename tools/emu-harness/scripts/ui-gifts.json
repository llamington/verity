// P8: picker -> overview -> Mystery gifts on the real Platinum save: list, deliver one (which
// fills the album, so the other gifts then show why they cannot be delivered), save to SD.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-gifts-00-overview"}, {"screenshot": "00-overview.png"},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 90},
    {"assert_screen": "ui-gifts-01-list"}, {"screenshot": "01-list.png"},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-gifts-02-selected"}, {"screenshot": "02-selected.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 30},
    {"assert_screen": "ui-gifts-03-delivered"}, {"screenshot": "03-delivered.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 30},
    {"assert_screen": "ui-gifts-04-duplicate"}, {"screenshot": "04-duplicate.png"},
    {"press": ["B"], "frames": 2},
    {"wait": 30},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 240},
    {"assert_screen": "ui-gifts-05-saved"}, {"screenshot": "05-saved.png"}
  ]
}
