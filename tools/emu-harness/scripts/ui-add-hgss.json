// Wizard on the HG save: add a legal HeartGold wild Pokemon, then save to SD.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "rtc": [2026, 11, 2, 12, 0, 0],
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"assert_screen": "ui-add-hgss-00-picker"}, {"screenshot": "00-picker.png"},
    {"press": ["A"], "frames": 2}, {"wait": 60},
    {"press": ["A"], "frames": 2}, {"wait": 40},
    {"press": ["L"], "frames": 2}, {"wait": 5},
    {"press": ["X"], "frames": 2}, {"wait": 60},
    {"assert_screen": "ui-add-hgss-01-species"}, {"screenshot": "01-species.png"},
    {"press": ["A"], "frames": 2},
    {"wait_screen": "ui-add-hgss-02-encounters", "timeout": 60}, {"screenshot": "02-encounters.png"},
    {"press": ["A"], "frames": 2}, {"wait": 5},
    {"press": ["Start"], "frames": 2}, {"wait": 60},
    {"assert_screen": "ui-add-hgss-03-placed"}, {"screenshot": "03-placed.png"},
    {"press": ["B"], "frames": 2}, {"wait": 40},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2}, {"wait": 180},
    {"assert_screen": "ui-add-hgss-04-saved"}, {"screenshot": "04-saved.png"}
  ]
}
