// P9.1: editor walk-through on the Pt save (gen4_platinum): moves picker, legal vs game-safe.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    // Picked by its name on screen, so files added to the SD card don't move the pick.
    {"tap_image": "../templates/pick-gen4-platinum.png"},
    {"wait_screen": "edit-picker", "timeout": 60},
    {"screenshot": "00-picker.png"},
    {"press": ["A"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "overview"}}, "timeout": 900},
    {"press": ["A"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "boxes"}}, "timeout": 900},
    // R moves to box 2; its first Pokémon's legality check takes over a frame, so wait for the
    // result before pressing A, or a short press can fall between two key scans.
    {"press": ["R"], "frames": 2},
    {"wait_screen": "edit-box2", "timeout": 120},
    {"press": ["A"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "editor"}}, "timeout": 900},
    {"assert_screen": "edit-main"},
    {"screenshot": "01-editor-main.png"},
    {"press": ["Down"], "frames": 2},
    {"press": ["Right"], "frames": 2}, {"press": ["Right"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "edit-level"},
    {"screenshot": "02-level.png"},
    {"press": ["R"], "frames": 2}, {"press": ["R"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 5},
    {"hold": ["Down"], "frames": 50},
    {"wait": 2},
    {"assert_screen": "edit-move-picker"},
    {"screenshot": "03-move-picker.png"},
    {"press": ["A"], "frames": 2},
    {"wait": 10},
    {"assert_screen": "edit-move-picked"},
    {"screenshot": "04-move-picked.png"},
    {"press": ["Start"], "frames": 2},
    {"wait": 10},
    {"assert_screen": "edit-apply-legal"},
    {"screenshot": "05-apply-legal.png"},
    {"press": ["Select"], "frames": 2},
    {"press": ["Start"], "frames": 2},
    {"wait": 10},
    {"assert_screen": "edit-apply-gamesafe"},
    {"screenshot": "06-apply-gamesafe.png"},
    {"press": ["B"], "frames": 2},
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "boxes"}}, "timeout": 900},
    {"assert_screen": "edit-box"},
    {"screenshot": "07-box.png"}
  ]
}
