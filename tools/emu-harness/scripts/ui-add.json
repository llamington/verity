// P9.1 slice 3: add a legal Pokemon with the wizard into the Pt save, then save to SD.
{
  "rom": "../../../nds/verity.nds",
  "sd_dir": "../../../build/emu/sd",
  "sd_fresh": true,
  "elf": "../../../nds/build/verity.elf",
  "needles": "../needles",
  "rtc": [2026, 11, 2, 12, 0, 0],
  "steps": [
    {"wait_until": {"ram": {"addr": "verity_test_scene", "text": "files"}}, "timeout": 900},
    {"hold": ["L"], "frames": 40}, {"wait": 2},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 60},
    {"press": ["A"], "frames": 2},
    {"wait": 40},
    {"press": ["L"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-add-00-last-box"}, {"screenshot": "00-last-box.png"},
    {"press": ["X"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-add-01-species"}, {"screenshot": "01-species.png"},
    {"press": ["Down"], "frames": 2}, {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-add-02-encounters"}, {"screenshot": "02-encounters.png"},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 5},
    {"press": ["Right"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Right"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Right"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Right"], "frames": 2},
    {"press": ["Right"], "frames": 2},
    {"wait": 5},
    {"assert_screen": "ui-add-03-options"}, {"screenshot": "03-options.png"},
    {"press": ["Start"], "frames": 2},
    {"wait": 60},
    {"assert_screen": "ui-add-04-placed"}, {"screenshot": "04-placed.png"},
    {"press": ["B"], "frames": 2},
    {"wait": 40},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["Down"], "frames": 2},
    {"press": ["A"], "frames": 2},
    {"wait": 180},
    {"assert_screen": "ui-add-05-saved"}, {"screenshot": "05-saved.png"}
  ]
}
