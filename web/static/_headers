# Cloudflare Pages response headers.

# Content-hashed bundles (JS, CSS, WASM, fonts) never change under one name.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Data blobs keep their names across releases; browsers keep them and revalidate (a 304 when
# unchanged), so new code never reads an old blob.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
