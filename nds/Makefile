BLOCKSDS	?= /opt/blocksds/core

NAME		:= verity
GAME_TITLE	:= Verity
# The release tag (v0.1.0) on a tagged commit; otherwise e.g. v0.1.0-3-gabc1234, or the hash.
VERSION		:= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
GAME_SUBTITLE	:= Gen 4/5 save editor $(VERSION)
GAME_AUTHOR	:= verity contributors
# Generated by assets/logo/mark.py.
GAME_ICON	:= icon.gif

SOURCEDIRS	:= source
INCLUDEDIRS	:= include
GFXDIRS		:= graphics
NITROFSDIR	:= nitrofiles

RUST_LIB	:= ../target/armv5te-none-eabi/release/libverity_ffi.a

LIBS		:= -lverity_ffi -lnds9
LIBDIRS		:= $(BLOCKSDS)/libs/libnds $(CURDIR)/rust

include $(BLOCKSDS)/sys/default_makefiles/rom_arm9/Makefile

rust/lib/libverity_ffi.a: FORCE
	cd .. && cargo build-ds
	@mkdir -p rust/lib
	cp $(RUST_LIB) $@

$(ELF): rust/lib/libverity_ffi.a

# Data blobs the front end loads from NitroFS (generated by scripts/build-data.sh).
BLOBS		:= strings_en dp pt hgss bw b2w2 moves4 moves5 enc_dppt enc_hgss enc_bw enc_b2w2 enc_dr names4 names5 gifts5 gifts4 g3_origin events4 events5
$(ROM): nitrofiles/data/.stamp
# BlocksDS's ROM rule needs the (gitignored) folder itself; the stamp rule creates it.
$(NITROFSDIR): nitrofiles/data/.stamp
nitrofiles/data/.stamp: $(foreach b,$(BLOBS),../data/blobs/$(b).bin) Makefile
	@mkdir -p nitrofiles/data
	cp $(filter %.bin,$^) nitrofiles/data/
	@touch $@

.PHONY: FORCE
FORCE:
